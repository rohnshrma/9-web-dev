<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Job Portal | All Jobs</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar container">
        <a href="/jobs" class="brand">Job Portal</a>
        <div class="nav-links">
          <a href="/jobs" class="nav-link active">Jobs</a>
          <a href="/login" class="nav-link">Login</a>
          <a href="/register" class="nav-link">Register</a>
          <a href="/jobs/new" class="btn btn-primary">Add New Job</a>
        </div>
      </nav>
    </header>

    <main class="container main-content">
      <% if (success) { %>
      <p class="alert success"><%= success %></p>
      <% } %>
      <% if (error) { %>
      <p class="alert error"><%= error %></p>
      <% } %>

      <section>
        <h2>Available Jobs</h2>

        <% if (!jobs.length) { %>
        <div class="empty-state">
          <h3>No jobs posted yet.</h3>
          <p>Start by adding your first job opening.</p>
          <a href="/jobs/new" class="btn btn-primary">Create Job</a>
        </div>
        <% } else { %>
        <div class="jobs-grid">
          <% jobs.forEach((job) => { %>
          <article class="job-card">
            <div class="job-card-top">
              <h3><%= job.title %></h3>
              <span class="badge"><%= job.type %></span>
            </div>
            <p class="meta"><strong>Company:</strong> <%= job.company %></p>
            <p class="meta"><strong>Location:</strong> <%= job.location || "Not specified" %></p>
            <p class="meta"><strong>Salary:</strong> <%= job.salary || "Not disclosed" %></p>
            <p class="meta"><strong>Posted:</strong> <%= new Date(job.createdAt).toLocaleDateString() %></p>

            <div class="actions">
              <a href="/jobs/<%= job._id %>" class="btn btn-secondary">View</a>
              <a href="/jobs/<%= job._id %>/edit" class="btn btn-edit">Edit</a>
              <form action="/jobs/<%= job._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this job?');">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </article>
          <% }) %>
        </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
