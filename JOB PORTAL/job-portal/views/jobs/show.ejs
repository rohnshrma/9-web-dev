<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Job Portal | Job Details</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar container">
        <a href="/jobs" class="brand">Job Portal</a>
        <div class="nav-links">
          <a href="/jobs" class="nav-link">Jobs</a>
          <a href="/login" class="nav-link">Login</a>
          <a href="/register" class="nav-link">Register</a>
          <a href="/jobs/new" class="btn btn-primary">Add New Job</a>
        </div>
      </nav>
    </header>

    <main class="container main-content">
      <% if (success) { %>
      <p class="alert success"><%= success %></p>
      <% } %>
      <% if (error) { %>
      <p class="alert error"><%= error %></p>
      <% } %>

      <article class="job-details">
        <h2><%= job.title %></h2>
        <p><strong>Company:</strong> <%= job.company %></p>
        <p><strong>Location:</strong> <%= job.location || "Not specified" %></p>
        <p><strong>Type:</strong> <%= job.type %></p>
        <p><strong>Salary:</strong> <%= job.salary || "Not disclosed" %></p>
        <p><strong>Posted On:</strong> <%= new Date(job.createdAt).toLocaleString() %></p>

        <div class="description">
          <h3>Job Description</h3>
          <p><%= job.description %></p>
        </div>

        <div class="actions">
          <a href="/jobs/<%= job._id %>/edit" class="btn btn-edit">Edit Job</a>
          <form action="/jobs/<%= job._id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this job?');">
            <button type="submit" class="btn btn-danger">Delete Job</button>
          </form>
        </div>
      </article>
    </main>
  </body>
</html>
